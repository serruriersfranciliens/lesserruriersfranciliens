---
import { FileText, Phone } from '@lucide/astro';
import { company } from '@/content/company';
import { buttonVariants } from '@/components/ui/button';
import WhatsAppIcon from '@/components/WhatsAppIcon.astro';
import { cn } from '@/lib/utils';

// Fixed bottom bar on small screens: call, WhatsApp or ask for a quote in one tap.
---

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 gap-2 bg-ink px-3 pt-2.5 pb-[calc(0.625rem+env(safe-area-inset-bottom))] shadow-[0_-6px_20px_rgb(0_0_0/0.2)] md:hidden">
  <a
    href={company.whatsappHref}
    target="_blank"
    rel="noreferrer"
    class={cn(buttonVariants({ size: 'xl' }), 'w-full gap-1 px-1 text-sm')}
  >
    <WhatsAppIcon variant="black" class="size-4.5" />
    WhatsApp
  </a>
  <a
    href={company.phoneHref}
    class={cn(
      buttonVariants({ size: 'xl', variant: 'outline' }),
      'w-full gap-1.5 border-white bg-white px-1 text-sm',
    )}
  >
    <Phone aria-hidden="true" />
    Appeler
  </a>
  <a
    href="/contact"
    class={cn(
      buttonVariants({ size: 'xl', variant: 'outline' }),
      'w-full gap-1.5 border-white bg-white px-1 text-sm',
    )}
  >
    <FileText aria-hidden="true" />
    Devis
  </a>
</div>
