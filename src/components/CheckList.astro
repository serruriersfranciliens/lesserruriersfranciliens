---
import { cn } from '@/lib/utils';

type Props = { items: string[]; class?: string };
const { items, class: className } = Astro.props;
---

<ul class={cn('mb-6 grid gap-2.5', className)}>
  {
    items.map((item) => (
      <li class="relative pl-8 before:absolute before:top-[0.45em] before:left-0 before:h-2.5 before:w-4 before:-rotate-45 before:border-b-[3px] before:border-l-[3px] before:border-brand">
        {item}
      </li>
    ))
  }
</ul>
