---
import { cn } from '@/lib/utils';
import Eyebrow from './Eyebrow.astro';

type Props = {
  eyebrow?: string;
  title: string;
  lead?: string;
  center?: boolean;
  as?: 'h1' | 'h2';
  class?: string;
};
const { eyebrow, title, lead, center, as: Heading = 'h2', class: className } = Astro.props;
---

<div data-reveal="stagger" class={cn('mb-10 max-w-3xl', center && 'mx-auto text-center', className)}>
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  <Heading class="mb-3 text-4xl md:text-5xl">{title}</Heading>
  {lead && <p class="text-lg text-muted-foreground">{lead}</p>}
</div>
