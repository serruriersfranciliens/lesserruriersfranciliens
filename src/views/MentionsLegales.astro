import PageHeader from '@/components/PageHeader.astro';
import Section from '@/components/Section.astro';

const { legal } = company;

const versionDate = '19 novembre 2026';

// Sommaire: keep in sync with the ids below.
const toc = [
  { id: 'editeur', label: '1. Éditeur' },
  { id: 'acceptation', label: '2.1. Acceptation des conditions' },
  { id: 'description', label: '2.2. Description du Service' },
  { id: 'rendez-vous', label: '2.3. Prise de rendez-vous et devis' },
  { id: 'acces', label: '2.4. Accès au Service' },
  { id: 'informations', label: '2.5. Communication d’informations' },
  { id: 'propriete-intellectuelle', label: '2.6. Propriété intellectuelle' },
  { id: 'utilisations', label: '2.7. Utilisations non autorisées' },
  { id: 'liens-sortants', label: '2.8. Liens vers des sites tiers' },
  { id: 'liens-entrants', label: '2.9. Liens vers le Service' },
  { id: 'responsabilite', label: '2.10. Garantie et responsabilité' },
  { id: 'donnees', label: '2.11. Données personnelles' },
  { id: 'modifications', label: '2.12. Modifications du Service' },
  { id: 'loi', label: '2.13. Loi applicable et juridiction' },
  { id: 'contact', label: '2.14. Contact' },
  { id: 'cookies', label: '2.15. Cookies et mesure d’audience' },
  { id: 'mediation', label: '2.16. Médiation de la consommation' },
